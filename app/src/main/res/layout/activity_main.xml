<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/_20_gl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.20"/>

    <TextView
        android:id="@+id/us_points_label_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/us"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="@id/_20_gl"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/us_points_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="40sp"
        android:gravity="center_horizontal"
        app:layout_constraintStart_toStartOf="@id/us_points_label_tv"
        app:layout_constraintEnd_toEndOf="@id/us_points_label_tv"
        app:layout_constraintTop_toBottomOf="@id/us_points_label_tv"
        />

    <Button
        android:id="@+id/us_point_bt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        android:text="+1"
        app:layout_constraintStart_toStartOf="@id/us_points_tv"
        app:layout_constraintEnd_toEndOf="@id/us_points_tv"
        app:layout_constraintTop_toBottomOf="@id/us_points_tv" />
  </androidx.constraintlayout.widget.ConstraintLayout>